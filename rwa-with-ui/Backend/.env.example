# Copy to Backend/.env and fill in your key:  cp .env.example .env
# .env is git-ignored. Use KEY=value with NO spaces around "=".
#
# The model id and thinking level are NOT here -- they live in config/llm.yaml.

# Required. The only credential the application needs.
OPENAI_API_KEY=sk-...

# Optional: LangSmith tracing. Leave blank to disable (no noisy auth errors).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Explainability

# Optional: browser origin(s) allowed to call the API, comma-separated.
# `ng serve` runs on :4200. Same-origin behind nginx does not need this.
CORS_ORIGINS=http://localhost:4200

# Optional: server bind settings.
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Optional: override where the Excel files are read from (relative to Backend/).
# RWA_SOURCE_TABLES_FILE=data/Main Data.xlsx
# RWA_DECISION_TREE_FILE=docs/decision-trees/Issue Types and Steps.xlsx
# RWA_LLM_CONFIG_FILE=config/llm.yaml

# Optional: hard stop on the orchestrator's decision-tree loop.
# RWA_AGENT_RECURSION_LIMIT=100
