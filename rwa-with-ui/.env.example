# Copy to ".env" and fill in real values:  cp .env.example .env
# IMPORTANT: use KEY=value with NO spaces around "=" (Docker Compose env_file).
# The .env file holds secrets and is git-ignored — never commit it.

# Required: OpenAI key (the agent uses gpt-4o).
OPENAI_API_KEY=sk-...

# Optional: only needed if your graph paths use Google models.
GOOGLE_API_KEY=

# Optional: enables LangSmith tracing when set; leave blank to disable.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Explainability

# Browser origin(s) allowed to call the API directly (comma-separated). The SPA
# is same-origin behind nginx so it never needs this, but set it for
# correctness. Origins only — no path, so no "/rwa-enhance" here.
# When you add a domain + HTTPS, change to e.g. https://app.example.com
CORS_ORIGINS=http://91.230.110.121

# Written by the GitHub Actions deploy job, not by hand: the exact GHCR tags of
# the release currently running. Present so a reboot or a manual
# `docker compose up -d` restarts that same release rather than a stale local
# build. Leave them out for a local build from source.
# BACKEND_IMAGE=ghcr.io/vihanga22365/rwa-enhance-backend:<sha>
# FRONTEND_IMAGE=ghcr.io/vihanga22365/rwa-enhance-frontend:<sha>
